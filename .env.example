# -------------------------------------------------------------------
# Scalekit AgentKit x Phoenix tracing demo
#
# DEMO USAGE:
#   cp .env.example .env.local
#   Fill real values. Nothing here is NEXT_PUBLIC_* — every credential
#   below stays server-side, which is the point.
#
# PRODUCTION / LIVE APPS:
#   - The identifier comes from your authenticated user, not a static env var.
#   - Keep SCALEKIT_CLIENT_SECRET and OPENAI_API_KEY server-only.
#   - Set PHOENIX_PROJECT_NAME per environment so staging traces do not mix
#     with production.
# -------------------------------------------------------------------

# --- Scalekit -------------------------------------------------------
# Dashboard -> Developers -> API credentials
SCALEKIT_ENV_URL=https://your-env.scalekit.com
SCALEKIT_CLIENT_ID=skc_...
SCALEKIT_CLIENT_SECRET=skcs_...

# The key you use to tell Scalekit "run tools as this user".
# Must match the identifier of an ACTIVE connection.
#
# How to find it:
# 1. Scalekit Dashboard -> AgentKit -> Connected Accounts
# 2. Find a connection showing as "Active"
# 3. Copy its "Identifier" value (often an email or user ID)
#
# Start with Scalekit-managed GitHub, Gmail, and Slack connections
# (AgentKit → Connections → Use Scalekit credentials).
#
# Privacy note: identifier, tool args, tool results, and chat content are written
# into Phoenix traces (and into the demo UI). Use a non-prod identifier for demos.
TEST_IDENTIFIER=your-test-identifier-here

# Optional. Comma-separated connection names for listScopedTools (e.g. github,gmail).
# When unset, the demo uses listAvailableTools(identifier) so it stays connector-agnostic.
# SCALEKIT_CONNECTION_NAMES=
# SCALEKIT_PROVIDERS=

# --- OpenAI / OpenAI-compatible proxy (LiteLLM, etc.) ---------------
# Direct OpenAI: leave OPENAI_BASE_URL blank (or delete the line).
# LiteLLM / Scalekit LLM Gateway / any OpenAI-compatible proxy: set both
# OPENAI_BASE_URL and OPENAI_API_KEY (proxy virtual key). OPENAI_MODEL must be
# a model id the gateway exposes (curl $OPENAI_BASE_URL/models with the key).
#
# Aliases also accepted: LITELLM_API_KEY, LITELLM_BASE_URL, OPENAI_API_BASE.
# Host with or without trailing /v1 is fine — the app normalizes to /v1.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=http://localhost:4000/v1
# Model id as configured in LiteLLM (not always the upstream OpenAI name).
OPENAI_MODEL=gpt-4o-mini

# --- Phoenix (local) ------------------------------------------------
# Run: uvx arize-phoenix serve
# UI:  http://localhost:6006
# Default collector if unset: http://localhost:6006/v1/traces
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=agentkit-tracing-demo
